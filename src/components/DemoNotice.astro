---
import Icon from './Icon.astro';
interface Props {
  text?: string;
}
const { text = 'Demo sadržaj: podaci na ovoj stranici su primer i još nisu provereni. Ne koristiti kao stvarne informacije.' } = Astro.props;
---

<div class="border-b border-warn/20 bg-warn-bg" role="note">
  <div class="container-site flex items-center gap-2 py-2 text-[13px] font-medium text-warn">
    <Icon name="alert" size={16} class="shrink-0" />
    <p>{text}</p>
  </div>
</div>
