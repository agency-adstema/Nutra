---
import Icon from './Icon.astro';
interface Props {
  items: { q: string; a: string }[];
  title: string;
  id?: string;
}
const { items, title, id = 'faq' } = Astro.props;
---

{
  items.length > 0 && (
    <section id={id} aria-labelledby={`${id}-title`} class="scroll-mt-28">
      <h2 id={`${id}-title`} class="text-2xl font-semibold text-brand-strong sm:text-[2rem]">{title}</h2>
      <div class="mt-5 divide-y divide-line overflow-hidden rounded-2xl border border-line bg-paper">
        {items.map((f) => (
          <details class="group/faq">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-semibold text-ink hover:bg-black/[0.02] [&::-webkit-details-marker]:hidden">
              <h3 class="font-sans text-base font-semibold tracking-normal sm:text-[17px]">{f.q}</h3>
              <Icon name="chevron-down" size={20} class="shrink-0 text-muted transition-transform group-open/faq:rotate-180" />
            </summary>
            <p class="px-5 pb-5 leading-relaxed text-ink/85">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  )
}
