---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import ReviewStars from './ReviewStars.astro';
import OfferPrice from './OfferPrice.astro';
import { productUrl, type Product } from '../lib/content';
import { formatPrice, priceView, themeStyle } from '../lib/format';
import { getEditorialPrice } from '../data/offer-pricing';
import { getMarket } from '../config/countries';

interface Props {
  product: Product;
  list?: string;
  eager?: boolean;
}
const { product, list = 'products', eager = false } = Astro.props;
const d = product.data;
const pv = priceView(d.priceStatus, d.packages);
const quotedPricing = getEditorialPrice(d.countryCode, d.slug);
const market = getMarket(d.countryCode);
const href = productUrl(product);
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-[22px] border border-[#e5e2d9] bg-white shadow-sm transition-shadow hover:shadow-[var(--shadow-soft)]"
  style={themeStyle(d)}
  data-editorial-product-card
>
  <a
    href={href}
    class="relative grid h-60 shrink-0 place-items-center overflow-hidden bg-brand-2 p-4"
    tabindex="-1"
    aria-hidden="true"
    data-select-item data-list={list} data-item-id={d.slug}
    data-item-name={d.name} data-item-category={d.category.id}
  >
    <Picture
      src={d.heroImage}
      alt={d.heroImageAlt}
      widths={[360,560,720]}
      sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw"
      formats={['avif','webp']}
      fallbackFormat="webp"
      class="h-full max-h-[226px] w-full object-contain transition-transform duration-500 group-hover:scale-[1.03]"
      loading={eager ? 'eager' : 'lazy'}
    />
    <span class="absolute left-3 top-3 max-w-[80%] rounded-full bg-[#173d22] px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-white">
      {d.productType}
    </span>
  </a>

  <div class="flex min-h-[286px] flex-1 flex-col px-5 pb-5 pt-4">
    <ReviewStars geo={d.countryCode} slug={d.slug} />

    <h3 class="mt-1.5 line-clamp-2 min-h-[2rem] font-serif text-xl font-bold leading-7 text-[#173d22]">
      <a href={href} class="hover:text-brand" data-select-item data-list={list}
         data-item-id={d.slug} data-item-name={d.name} data-item-category={d.category.id}>
        {d.name}
      </a>
    </h3>

    <p class="mt-1 line-clamp-2 min-h-[3rem] text-sm leading-6 text-ink/80">
      {d.shortDescription}
    </p>

    <div class="mt-auto pt-4">
      {quotedPricing ? (
        <OfferPrice pricing={quotedPricing} catalogCard />
      ) : pv.show ? (
        <div class="flex min-h-[60px] flex-col justify-end">
          <span class="text-xs text-muted">Cena od</span>
          <strong class="whitespace-nowrap text-xl font-extrabold leading-7 text-brand">{formatPrice(pv.min!, market.currencyLabel)}</strong>
        </div>
      ) : (
        <p class="text-xs text-muted">Cena na upit</p>
      )}
      <a href={href} class="mt-3 flex w-full items-center justify-center gap-2 rounded-xl bg-[#1f5a2c] px-4 py-3.5 text-base font-bold text-white shadow-md shadow-[#1f5a2c]/25 transition hover:bg-[#173d22] active:scale-[0.99]"
         data-select-item data-list={list}
         data-item-id={d.slug} data-item-name={d.name} data-item-category={d.category.id}>
        <Icon name="cart" size={20} /> Naruči odmah
      </a>
    </div>
    <p class="mt-2.5 text-center text-xs font-bold text-[#225b37]">Besplatna dostava · Plaćanje pouzećem</p>
  </div>
</article>
