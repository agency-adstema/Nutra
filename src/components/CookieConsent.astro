---
import { PUBLIC_GA4_ID, PUBLIC_GTM_ID } from 'astro:env/client';
// Banner je potreban samo ako postoji analitika koja koristi kolačiće
const enabled = !!(PUBLIC_GA4_ID || PUBLIC_GTM_ID);
---

{
  enabled && (
    <div
      id="cookie-consent"
      class="fixed inset-x-3 bottom-3 z-[60] mx-auto max-w-2xl rounded-2xl border border-line bg-paper p-4 shadow-2xl sm:p-5"
      role="dialog"
      aria-labelledby="cc-title"
      aria-describedby="cc-desc"
      hidden
    >
      <p id="cc-title" class="font-display text-lg font-semibold text-ink">Kolačići</p>
      <p id="cc-desc" class="mt-1 text-sm text-muted">
        Koristimo neophodne tehničke podatke da bi sajt i poručivanje radili. Uz vašu saglasnost koristimo i Google Analytics
        da bismo merili posete — bez imena i brojeva telefona. <a href="/kolacici/" class="font-medium text-brand underline">Više o kolačićima</a>
      </p>
      <div class="mt-4 flex flex-col gap-2 sm:flex-row sm:justify-end">
        <button type="button" class="btn-ghost py-2.5" data-consent="deny">Samo neophodni</button>
        <button type="button" class="btn-primary py-2.5" data-consent="accept">Prihvati analitiku</button>
      </div>
    </div>
  )
}

<script>
  import { getConsent, setConsent } from '../scripts/consent';
  const box = document.getElementById('cookie-consent');
  if (box) {
    if (!getConsent()) box.hidden = false;
    box.addEventListener('click', (e) => {
      const btn = (e.target as Element).closest<HTMLButtonElement>('[data-consent]');
      if (!btn) return;
      setConsent(btn.dataset.consent === 'accept');
      box.hidden = true;
    });
    document.querySelectorAll('[data-open-consent]').forEach((el) =>
      el.addEventListener('click', () => {
        box.hidden = false;
        box.querySelector<HTMLButtonElement>('[data-consent="accept"]')?.focus();
      }),
    );
  } else {
    document.querySelectorAll<HTMLElement>('[data-open-consent]').forEach((el) => (el.hidden = true));
  }
</script>
