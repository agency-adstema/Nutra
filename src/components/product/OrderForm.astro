---
import Icon from '../Icon.astro';
import { site } from '../../config/site';
import { formatPrice, priceView } from '../../lib/format';
import type { Product } from '../../lib/content';
import type { Offer } from '../../data/offers';
import { getOfferDetails } from '../../data/offer-details';
import { getCatalogPrice, getEditorialPrice, formatCatalogPrice, referencePriceNotice } from '../../data/offer-pricing';
import { getCatalogPrice } from '../../data/offer-pricing';
import type { MarketConfig } from '../../config/countries';
import { PUBLIC_STATIC_PREVIEW, PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';

interface Props {
  product?: Product;
  offer?: Offer;
  market: MarketConfig;
}
const { product, offer, market } = Astro.props;
if (!product && !offer) throw new Error('OrderForm requires product or offer');
const d = product?.data;
const isCatalogPreview = !!offer;
const catalogDetails = offer ? getOfferDetails(offer.geo, offer.slug) : undefined;
const editorialPricing = product ? getEditorialPrice(d!.countryCode, d!.slug) : undefined;
const catalogPricing = offer ? getCatalogPrice(offer.geo, offer.slug) : undefined;
// Catalog forms are always in SAFE preview mode, including if the site is later built for production.
// Until a real API offer ID and approved seller details are configured, nothing may be transmitted.
const name = offer?.name ?? d!.name;
const slug = offer ? `${offer.geo.toLowerCase()}-${offer.slug}` : d!.slug;
const category = offer ? offer.verticals[0] : d!.category.id;
const currency = offer ? market.currency : d!.currency;
const priceStatus = offer ? 'unknown' as const : d!.priceStatus;
const packages = offer
  ? (catalogPricing?.tiers.map(t => ({ id: t.id, label: t.label, quantity: t.quantity, default: t.quantity === 1, price: t.newPrice })) ??
     [{ id: '1-komad', label: '1 pakovanje', quantity: 1, default: true, price: undefined }])
  : (editorialPricing?.tiers.map(t => ({ id: t.id, label: t.label, quantity: t.quantity, default: t.quantity === 1, price: t.newPrice })) ?? d!.packages);
const orderEnabled = isCatalogPreview ? catalogDetails?.availableInAccount === true : !!d?.orderEnabled;
const pv = priceView(priceStatus, packages);
const visiblePricing = catalogPricing ?? editorialPricing;
const defaultPkg = packages.find((p) => p.default) ?? packages[0];
const requireConsent = site.consentMode === 'checkbox';

const formConfig = {
  slug,
  name,
  category,
  currency,
  priceStatus,
  prices: Object.fromEntries(packages.map((p) => [p.id, p.price ?? null])),
  packageIds: packages.map((p) => p.id),
  phone: market.phone,
  requireConsent,
  endpoint: '/api/order/',
  staticPreview: isCatalogPreview || PUBLIC_STATIC_PREVIEW,
};

const labelCls = 'text-sm font-semibold text-ink sm:pt-2.5';
---

<section id="poruci" class="scroll-mt-28" aria-labelledby="order-title">
  <div class="overflow-hidden rounded-[1.5rem] border border-brand/15 bg-brand-2/60 shadow-[var(--shadow-soft)]">
    <div class="flex items-center justify-center gap-2.5 bg-brand px-5 py-4 text-white">
      <Icon name="leaf" size={24} class="text-white/90" />
      <h2 id="order-title" class="text-2xl font-semibold sm:text-[1.75rem]">Poručite {name}</h2>
    </div>

    {
      !orderEnabled ? (
        <p class="p-6 text-center text-muted">Ova ponuda trenutno nije dostupna u partnerskom nalogu za izabranu zemlju. Poručivanje nije moguće.</p>
      ) : (
        <form class="space-y-4 p-5 sm:p-6" novalidate data-order-form data-config={JSON.stringify(formConfig)}>
          {isCatalogPreview && (
            <div class="rounded-xl border border-warn/30 bg-warn-bg px-4 py-3 text-sm text-ink">
              <strong>Forma za poručivanje još nije aktivirana.</strong> Ovaj prikaz služi za proveru dizajna i validacije;
              nijedan uneti podatak neće biti poslat u CRM.
              {catalogPricing && <p class="mt-2">Cene za {catalogPricing.tiers.length} {catalogPricing.tiers.length === 1 ? 'opciju' : 'opcije'} pakovanja preuzete su iz partnerskog Excel cenovnika. Konačan iznos podleže potvrdi prodavca.</p>}
            </div>
          )}
          <div class="space-y-4" data-form-fields>
          <div class="grid gap-1.5 sm:grid-cols-[120px_1fr] sm:items-start sm:gap-4">
            <label for="of-first" class={labelCls}>Ime <span aria-hidden="true">*</span></label>
            <div>
              <input id="of-first" name="firstName" type="text" autocomplete="given-name" required maxlength="60" placeholder="Unesite ime" class="field-input" aria-describedby="of-first-err" />
              <p id="of-first-err" class="mt-1 text-sm text-danger" data-error-for="firstName" hidden />
            </div>
          </div>

          <div class="grid gap-1.5 sm:grid-cols-[120px_1fr] sm:items-start sm:gap-4">
            <label for="of-last" class={labelCls}>Prezime <span aria-hidden="true">*</span></label>
            <div>
              <input id="of-last" name="lastName" type="text" autocomplete="family-name" required maxlength="60" placeholder="Unesite prezime" class="field-input" aria-describedby="of-last-err" />
              <p id="of-last-err" class="mt-1 text-sm text-danger" data-error-for="lastName" hidden />
            </div>
          </div>

          <div class="grid gap-1.5 sm:grid-cols-[120px_1fr] sm:items-start sm:gap-4">
            <label for="of-phone" class={labelCls}>Broj telefona <span aria-hidden="true">*</span></label>
            <div>
              <input id="of-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required maxlength="25" placeholder={`npr. ${market.phone.example}`} class="field-input" aria-describedby="of-phone-err of-phone-hint" />
              <p id="of-phone-hint" class="mt-1 text-xs text-muted">Operater vas zove na ovaj broj radi potvrde porudžbine.</p>
              <p id="of-phone-err" class="mt-1 text-sm text-danger" data-error-for="phone" hidden />
            </div>
          </div>

          {
            packages.length > 1 ? (
              <fieldset class="grid gap-1.5 sm:grid-cols-[120px_1fr] sm:gap-4">
                <legend class="sr-only">Pakovanje</legend>
                <span class={labelCls} aria-hidden="true">Pakovanje</span>
                <div>
                  <div class="grid gap-2">
                    {packages.map((p) => (
                      <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-line bg-white px-3.5 py-2.5 transition-colors has-[:checked]:border-brand has-[:checked]:bg-brand-soft has-[:checked]:ring-2 has-[:checked]:ring-brand/15 hover:border-brand/50">
                        <input type="radio" name="packageId" value={p.id} checked={p.id === defaultPkg.id} class="h-4 w-4 shrink-0 accent-[var(--c-primary)]" />
                        <span class="flex-1 text-[15px] font-semibold text-ink">{p.label}</span>
                        <span class="text-[15px] font-semibold text-brand">
                          {(pv.show || visiblePricing) && p.price != null ? (
                            <>
                              <strong>{formatPrice(p.price, market.currencyLabel)}</strong>
                              {visiblePricing?.tiers.find(t => t.id === p.id)?.referencePrice != null && (
                                <del class="ml-2 text-xs font-normal text-muted">
                                  {formatCatalogPrice(visiblePricing.tiers.find(t => t.id === p.id)!.referencePrice!, visiblePricing.geo)}
                                </del>
                              )}
                            </>
                          ) : <span class="font-normal text-muted">cena nije objavljena</span>}
                        </span>
                      </label>
                    ))}
                  </div>
                  {visiblePricing?.freeShippingPerSheet && (
                    <p class="mt-3 text-xs text-muted">Besplatna dostava prema dostavljenom cenovniku partnera; potvrda uslova pre poručivanja.</p>
                  )}
                  <p class="mt-1 text-sm text-danger" data-error-for="packageId" hidden />
                </div>
              </fieldset>
            ) : (
              <input type="hidden" name="packageId" value={defaultPkg.id} />
            )
          }

          {visiblePricing && (
            <p class="text-xs text-muted">
              {editorialPricing ? referencePriceNotice(d!.slug) : 'Referentne cene iz Excel dokumenta nisu potvrđene kao prethodne prodajne cene.'}
              {' '}Izbor 2 ili 3 pakovanja je prikaz; za stvarno naručivanje mora se potvrditi prijem količine u call centru.
            </p>
          )}

          <!-- Honeypot: polje koje ljudi ne vide; botovi ga popune -->
          <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
            <label for="of-website">Ne popunjavajte ovo polje</label>
            <input id="of-website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          {
            requireConsent ? (
              <div>
                <label class="flex cursor-pointer items-start gap-3 text-[15px] text-ink/90">
                  <input name="consent" type="checkbox" required class="mt-0.5 h-5 w-5 shrink-0 rounded border-line accent-[var(--c-primary)]" aria-describedby="of-consent-err" />
                  <span>
                    Slažem se sa obradom podataka radi porudžbine.{' '}
                    <a href="/politika-privatnosti/" class="text-brand underline underline-offset-2">Politika privatnosti</a>
                  </span>
                </label>
                <p id="of-consent-err" class="mt-1 text-sm text-danger" data-error-for="consent" hidden />
              </div>
            ) : (
              <p class="text-sm text-muted">
                Slanjem porudžbine podatke koristimo samo za obradu porudžbine (izvršenje ugovora).{' '}
                <a href="/politika-privatnosti/" class="text-brand underline">Politika privatnosti</a>
              </p>
            )
          }

          {PUBLIC_TURNSTILE_SITE_KEY && <div class="cf-turnstile" data-sitekey={PUBLIC_TURNSTILE_SITE_KEY} data-language="sr" />}

          <button type="submit" class="btn-primary w-full py-3.5 text-lg disabled:cursor-wait disabled:opacity-70" data-submit>
            <Icon name="send" size={20} data-icon-idle />
            <svg class="hidden h-5 w-5 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true" data-icon-loading>
              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-opacity=".3" stroke-width="3" />
              <path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
            </svg>
            <span data-submit-label>{isCatalogPreview || PUBLIC_STATIC_PREVIEW ? 'Proveri formu' : 'Pošalji porudžbinu'}</span>
          </button>
          </div>

          <div role="status" aria-live="polite" data-order-status hidden />

          <p class="flex items-center justify-center gap-2 text-center text-sm text-ink/80">
            <Icon name="truck" size={18} class="shrink-0" />
            {isCatalogPreview
              ? 'Planirano plaćanje pouzećem nakon aktiviranja ponude.'
              : 'Plaćanje pouzećem. Operater će vas kontaktirati radi potvrde porudžbine.'}
          </p>
        </form>
      )
    }
  </div>
  <p class="mt-3 px-1 text-xs leading-relaxed text-muted">
    Porudžbinu obrađuje {site.orderProcessing.sellerDescription}. {site.name} nije prodavac niti apoteka. Detalji:{' '}
    <a href="/obrada-porudzbina/" class="underline hover:text-ink">obrada porudžbina</a>.
  </p>
</section>

{PUBLIC_TURNSTILE_SITE_KEY && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer />}

<script>
  import { initOrderForms } from '../../scripts/order-form';
  initOrderForms();
</script>
