---
import Icon from '../Icon.astro';
import type { OfferGeo } from '../../data/offers';
import { getProductVideos } from '../../lib/product-videos';
interface Props { geo: OfferGeo; slug: string; productName: string; }
const { geo, slug, productName } = Astro.props;
const videos = getProductVideos(geo,slug);
const id = `product-videos-${geo.toLowerCase()}-${slug}`;
---
{videos.length > 0 && (
<section
  id={id}
  class="mt-8 min-w-0 border-t border-line pt-6"
  data-product-video-gallery
  data-product-video-count={videos.length}
  aria-labelledby={`${id}-heading`}
>
  <div class="mb-4 flex items-center justify-between gap-4">
    <div>
      <h2 class="font-serif text-xl font-bold text-brand-strong sm:text-2xl" id={`${id}-heading`}>
        Iskustva naših kupaca
      </h2>
      <p class="mt-1 text-xs leading-relaxed text-muted">Video snimci o proizvodu {productName}</p>
    </div>
    <div class="flex shrink-0 items-center gap-2 lg:hidden" aria-label="Navigacija kroz video iskustva">
      <button type="button" data-video-prev disabled aria-label="Prethodna dva videa"
        class="grid h-10 w-10 place-items-center rounded-full border border-line bg-white text-brand disabled:cursor-not-allowed disabled:opacity-35">
        <Icon name="chevron-left" size={20} />
      </button>
      <span class="min-w-[38px] text-center text-xs font-semibold tabular-nums text-ink/70" data-video-current>
        1 / {Math.ceil(videos.length/2)}
      </span>
      <button type="button" data-video-next disabled={videos.length <= 2} aria-label="Sledeća dva videa"
        class="grid h-10 w-10 place-items-center rounded-full border border-line bg-white text-brand disabled:cursor-not-allowed disabled:opacity-35">
        <Icon name="chevron-right" size={20} />
      </button>
    </div>
  </div>
  <div
    class="grid grid-flow-col auto-cols-[calc((100%-0.75rem)/2)] gap-3 overflow-x-auto overscroll-x-contain scroll-smooth snap-x snap-mandatory pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden lg:grid-flow-row lg:grid-cols-4 lg:auto-cols-auto lg:overflow-visible lg:snap-none"
    data-video-viewport
    aria-label={`Video iskustva za ${productName}`}
  >
    {videos.map((video,i)=>(
      <figure class="min-w-0 snap-start" data-product-video-card data-video-index={i}>
        <div class="relative aspect-[9/16] overflow-hidden rounded-xl bg-[#e3eadc] ring-1 ring-black/5">
          <video
            src={video.src}
            poster={video.poster}
            preload="none"
            controls
            playsinline
            class="h-full w-full bg-[#e3eadc] object-cover"
            aria-label={`Video: ${video.title}`}
          ></video>
        </div>
        <figcaption class="mt-2 min-h-12 px-0.5">
          <strong class="block line-clamp-1 text-[13px] font-semibold text-ink">{video.title}</strong>
          {video.description && (
            <p class="mt-0.5 line-clamp-2 text-xs leading-5 text-ink/70">{video.description}</p>
          )}
        </figcaption>
      </figure>
    ))}
  </div>
  <p class="mt-3 text-[11px] leading-relaxed text-muted">
    Individualni rezultati mogu da se razlikuju.
  </p>
</section>
)}
<script>
  import { initProductVideoGalleries } from '../../scripts/product-video-gallery';
  initProductVideoGalleries();
</script>
