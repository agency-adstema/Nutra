---
import Icon from '../Icon.astro';
import type { OfferGeo } from '../../data/offers';
import { getProductVideos } from '../../lib/product-videos';

interface Props { geo: OfferGeo; slug: string; productName: string; }
const { geo, slug, productName } = Astro.props;
const videos = getProductVideos(geo, slug);
const id = `product-videos-${geo.toLowerCase()}-${slug}`;
---
{videos.length > 0 && (
  <section
    id={id}
    class="mt-8 min-w-0 border-t border-line pt-6"
    data-product-video-gallery
    data-product-video-count={videos.length}
    aria-labelledby={`${id}-heading`}
  >
    <div class="mb-4 flex items-center justify-between gap-4">
      <div>
        <h2 class="font-serif text-xl font-bold text-brand-strong sm:text-2xl" id={`${id}-heading`}>
          Iskustva naših kupaca
        </h2>
        <p class="mt-1 text-xs leading-relaxed text-muted">Video snimci o proizvodu {productName}</p>
      </div>
      <div class="flex shrink-0 items-center gap-2 lg:hidden" aria-label="Navigacija kroz video iskustva">
        <button type="button" data-video-prev disabled aria-label="Prethodna dva videa"
          class="grid h-10 w-10 place-items-center rounded-full border border-line bg-white text-brand disabled:cursor-not-allowed disabled:opacity-35">
          <Icon name="chevron-right" size={20} class="rotate-180" />
        </button>
        <span class="min-w-[38px] text-center text-xs font-semibold tabular-nums text-ink/70" data-video-current>
          1 / {Math.ceil(videos.length / 2)}
        </span>
        <button type="button" data-video-next disabled={videos.length <= 2} aria-label="Sledeća dva videa"
          class="grid h-10 w-10 place-items-center rounded-full border border-line bg-white text-brand disabled:cursor-not-allowed disabled:opacity-35">
          <Icon name="chevron-right" size={20} />
        </button>
      </div>
    </div>

    <div
      class="grid grid-flow-col auto-cols-[calc((100%-0.75rem)/2)] gap-3 overflow-x-auto overscroll-x-contain scroll-smooth snap-x snap-mandatory pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden lg:grid-flow-row lg:grid-cols-4 lg:auto-cols-auto lg:overflow-visible lg:snap-none"
      data-video-viewport
      aria-label={`Video iskustva za ${productName}`}
    >
      {videos.map((video, i) => (
        <figure class="min-w-0 snap-start" data-product-video-card data-video-index={i}>
          <div class="relative aspect-[9/16] overflow-hidden rounded-xl bg-[#cbd9c6] ring-1 ring-black/5">
            <!-- #t=0.5 and metadata let Chrome show a video frame before R2 JPG posters exist. -->
            <video
              src={`${video.src}#t=0.5`}
              poster={video.poster}
              preload="metadata"
              muted
              playsinline
              aria-hidden="true"
              tabindex="-1"
              class="pointer-events-none h-full w-full bg-[#cbd9c6] object-cover"
              data-video-preview
            ></video>
            <!-- The native play control is unusable on ~106px wide cards. -->
            <button
              type="button"
              data-video-open
              data-video-src={video.src}
              data-video-poster={video.poster}
              data-video-title={video.title}
              aria-label={`Pusti video recenziju: ${video.title}`}
              class="group absolute inset-0 z-10 grid h-full w-full cursor-pointer place-items-center bg-gradient-to-t from-black/20 via-transparent to-transparent transition-colors hover:from-black/35 focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-[-4px] focus-visible:outline-white"
            >
              <span class="grid h-14 w-14 place-items-center rounded-full bg-white/95 text-[#174b2a] shadow-[0_6px_30px_rgba(0,0,0,0.28)] ring-2 ring-white/70 transition-transform group-hover:scale-110 sm:h-16 sm:w-16" aria-hidden="true">
                <Icon name="play" size={29} class="translate-x-0.5" />
              </span>
            </button>
          </div>
          <figcaption class="mt-2 min-h-12 px-0.5">
            <strong class="block line-clamp-1 text-[13px] font-semibold text-ink">{video.title}</strong>
            {video.description && (
              <p class="mt-0.5 line-clamp-2 text-xs leading-5 text-ink/70">{video.description}</p>
            )}
          </figcaption>
        </figure>
      ))}
    </div>
    <p class="mt-3 text-[11px] leading-relaxed text-muted">
      Individualni rezultati mogu da se razlikuju.
    </p>

    <!-- Native dialog renders in the browser top layer, above the sticky header. -->
    <dialog
      data-video-dialog
      aria-label={`Video iskustvo — ${productName}`}
      class="fixed inset-0 m-auto max-h-[94dvh] w-[min(94vw,50.625dvh)] max-w-none overflow-visible border-0 bg-transparent p-0 text-white shadow-none backdrop:bg-black/85"
    >
      <div class="relative w-full">
        <button
          type="button"
          data-video-close
          aria-label="Zatvori video"
          class="absolute right-3 top-3 z-20 grid h-11 w-11 place-items-center rounded-full bg-black/75 text-white shadow-lg transition-colors hover:bg-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          <Icon name="close" size={24} />
        </button>
        <video
          data-video-player
          class="block aspect-[9/16] max-h-[90dvh] w-full rounded-2xl bg-black object-contain"
          preload="metadata"
          controls
          autoplay
          playsinline
          aria-label="Video iskustvo"
        ></video>
      </div>
    </dialog>
  </section>
)}
<script>
  import { initProductVideoGalleries } from '../../scripts/product-video-gallery';
  initProductVideoGalleries();
</script>
