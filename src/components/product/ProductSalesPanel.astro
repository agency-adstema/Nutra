---
import Icon from '../Icon.astro';
import ProductVideoGallery from './ProductVideoGallery.astro';
import ReviewStars from '../ReviewStars.astro';
import { formatCatalogPrice, popularPackageBadge, type CatalogPrice } from '../../data/offer-pricing';
import type { OfferGeo } from '../../data/offers';

interface Props {
  geo: OfferGeo;
  slug: string;
  name: string;
  headline?: string;
  categoryName: string;
  description: string;
  form?: string | null;
  packageSize?: string | null;
  highlights?: string[];
  pricing?: CatalogPrice;
  hasOrderForm?: boolean;
}
const {
  geo, slug, name, headline, categoryName, description,
  form, packageSize, highlights = [], pricing, hasOrderForm = true,
} = Astro.props;
const single = pricing?.tiers[0];
const old = single?.referencePrice != null ? formatCatalogPrice(single.referencePrice, geo) : null;
const current = single ? formatCatalogPrice(single.newPrice, geo) : null;
const saved = single?.savings != null ? formatCatalogPrice(single.savings, geo) : null;
const features = [...new Set(highlights.filter(Boolean))].slice(0, 4);
if (form && !features.some(x => x.toLowerCase().includes(form.toLowerCase()))) features.unshift(`Oblik proizvoda: ${form}`);
if (packageSize && !features.some(x => x.toLowerCase().includes(packageSize.toLowerCase()))) features.push(`Pakovanje: ${packageSize}`);
if (!features.length) features.push('Informacije o proizvodu i pakovanju pronađite u nastavku stranice');
const savedText = saved ? `UŠTEDA ${saved}` : '';
---
<div class="min-w-0" data-sales-panel data-market={geo}>
  <p class="inline-flex rounded-md bg-[#e5e9df] px-3 py-1 text-[11px] font-extrabold uppercase tracking-[0.14em] text-brand-strong">{categoryName}</p>
  <h1 class="mt-3 max-w-2xl font-serif text-[clamp(2.4rem,4.2vw,4.6rem)] font-bold leading-[1.04] tracking-[-0.04em] text-[#18371f]" data-sales-title>
    {headline || name}
  </h1>
  <p class="mt-4 max-w-[63ch] text-base leading-relaxed text-ink/80 sm:text-lg">{description}</p>

  <div class="mt-5 border-t border-line pt-4">
    <div class="mb-2 flex flex-wrap items-center gap-2">
      <span class="rounded bg-[#e8efe1] px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-[0.12em] text-[#1d4c2b]">{geo}</span>
      {form && <span class="rounded bg-paper px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-[0.12em] text-ink/75">{form}</span>}
      {packageSize && <span class="rounded bg-paper px-2.5 py-1 text-[10px] font-bold tracking-wide text-ink/75">{packageSize}</span>}
    </div>
    <h2 class="font-serif text-xl font-bold text-[#173d22]">{name}</h2>
    <ReviewStars geo={geo} slug={slug} showMissing={false} />

    <ul class="mt-4 space-y-2.5" aria-label="Osnovne karakteristike proizvoda">
      {features.map(text => (
        <li class="flex items-start gap-3 text-sm leading-relaxed text-ink/90 sm:text-[15px]">
          <span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-[#e4eadf] text-[#1c4a29]" aria-hidden="true">
            <Icon name="check" size={14} />
          </span>
          <span>{text}</span>
        </li>
      ))}
    </ul>
  </div>

  {single && pricing && (
    <div class="mt-5 border-t border-line pt-5" data-hero-price>
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-2">
        <strong class="text-[clamp(2rem,3.5vw,3.25rem)] font-extrabold leading-none tracking-tight text-[#102e1a]" data-hero-current-price>
          {current}
        </strong>
        {old && (
          <span class="text-xs text-muted">
            Referentna: <del class="whitespace-nowrap text-sm">{old}</del>
          </span>
        )}
        {saved && <span class="rounded-md bg-[#e2e7df] px-3 py-1 text-xs font-extrabold text-[#183f27]">{savedText}</span>}
      </div>
      <div class="mt-3 flex flex-wrap items-center gap-1.5 text-[13px] leading-relaxed">
        {pricing.freeShippingPerSheet && (
          <>
            <span class="font-bold text-brand">Besplatna dostava</span>
            <span class="text-muted">·</span>
          </>
        )}
        <span>Plaćanje pouzećem</span>
        {(pricing.estimatedDeliveryBusinessDays || !pricing.freeShippingPerSheet) && (
          <>
            <span class="text-muted">·</span>
            <span class="text-muted">{pricing.estimatedDeliveryBusinessDays ? 'Dostava 1–2 radna dana*' : 'Uslove dostave potvrđuje prodavac'}</span>
          </>
        )}
      </div>
      {pricing.estimatedDeliveryBusinessDays && <p class="text-[11px] text-muted">* Procena roka dostave iz dokumentacije partnera.</p>}

      {hasOrderForm && (
        <div class="mt-5 grid gap-2" aria-label="Izaberite pakovanje" data-hero-packages>
          {pricing.tiers.map((tier) => (
            <a
              href="#poruci"
              data-hero-package={tier.id}
              data-selected={tier.quantity === 1 ? 'true' : 'false'}
              class={`group flex items-center gap-3 rounded-xl border px-4 py-3 transition-colors hover:border-brand hover:bg-[#e9f1e4] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand data-[selected=true]:border-brand data-[selected=true]:bg-[#edf5e8] data-[selected=true]:ring-2 data-[selected=true]:ring-[#a4c7a8] ${tier.quantity === 3 ? 'border-[#2c6d3c] bg-[#e8f0e2]' : 'border-line bg-white'}`}
            >
              <span class="grid h-5 w-5 shrink-0 place-items-center rounded-full border-2 border-[#326f43]" aria-hidden="true">
                <span class="h-2 w-2 rounded-full bg-[#326f43] opacity-0 transition-opacity group-hover:opacity-100 group-data-[selected=true]:opacity-100"></span>
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-sm font-bold text-ink">{tier.label}</span>
                {popularPackageBadge(geo, tier.quantity, tier.discountPercent) && (
                  <span class="mt-1 inline-block max-w-full rounded-md bg-[#21562e] px-2 py-0.5 text-[10px] font-bold text-white">
                    {popularPackageBadge(geo, tier.quantity, tier.discountPercent)}
                  </span>
                )}
                {tier.quantity > 1 && <span class="mt-1 block text-[11px] text-muted">Po pakovanju: {formatCatalogPrice(tier.unitPrice, geo)}</span>}
              </span>
              <span class="shrink-0 text-right">
                {tier.referencePrice != null && <del class="block text-xs text-muted">{formatCatalogPrice(tier.referencePrice,geo)}</del>}
                <strong class="block whitespace-nowrap text-base font-extrabold text-brand">{formatCatalogPrice(tier.newPrice,geo)}</strong>
              </span>
              <Icon name="chevron-right" size={18} class="shrink-0 text-brand" />
            </a>
          ))}
        </div>
      )}
    </div>
  )}

  {hasOrderForm && (
    <a href="#poruci" data-hero-cta class="btn-primary mt-4 inline-flex w-full items-center justify-center gap-2 px-7 py-4 text-base font-bold shadow-md shadow-brand/15">
      <Icon name="cart" size={21} /> Poručite odmah
    </a>
  )}

  <!-- Two vertical clips per page, placed directly below the order button. -->
  <ProductVideoGallery geo={geo} slug={slug} productName={name} />
</div>
