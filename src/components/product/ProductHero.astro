---
import { Picture } from 'astro:assets';
import Breadcrumbs from '../Breadcrumbs.astro';
import ProductSalesPanel from './ProductSalesPanel.astro';
import { getEditorialPrice } from '../../data/offer-pricing';
import type { Product } from '../../lib/content';
import type { MarketConfig } from '../../config/countries';

interface Props {
  product: Product;
  categoryName: string;
  categoryHref: string;
  market: MarketConfig;
}
const { product, categoryName, categoryHref } = Astro.props;
const d = product.data;
const quotedPricing = getEditorialPrice(d.countryCode, d.slug);
const h1 = d.h1 ?? d.name;
const panelHighlights = d.highlights.map(h => h.label).filter(Boolean).slice(0,4);
---

<section class="relative overflow-hidden" data-hero>
  <div class="container-site relative pb-9 pt-4 lg:pb-14 lg:pt-5">
    <Breadcrumbs items={[{ name: categoryName, href: categoryHref }, { name: h1, href: '' }]} class="mb-5 lg:mb-6" />
    <div class="grid items-start gap-8 lg:grid-cols-[1.06fr_1fr] lg:gap-11 xl:gap-16">
      <div class="lg:sticky lg:top-[calc(var(--header-h)+1rem)]">
        <div class="relative flex min-h-[430px] items-center justify-center overflow-hidden rounded-[1.9rem] bg-brand-2 p-5 shadow-[var(--shadow-soft)] ring-1 ring-black/5 sm:min-h-[520px] lg:min-h-[680px] lg:p-8" data-sales-image>
          <Picture
            src={d.heroImage}
            alt={d.heroImageAlt}
            widths={[480,720,1104]}
            sizes="(min-width: 1024px) 560px, 100vw"
            formats={['avif','webp']}
            loading="eager"
            fetchpriority="high"
            class="h-[390px] w-full object-contain sm:h-[480px] lg:h-[620px]"
          />
          <span class="absolute left-4 top-4 max-w-[78%] rounded-full bg-[#1f4b2b] px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-white">{d.productType}</span>
        </div>
      </div>
      <ProductSalesPanel
        geo="RS"
        slug={d.slug}
        name={d.name}
        headline={h1}
        categoryName={categoryName}
        description={d.shortDescription}
        form={d.productType}
        highlights={panelHighlights}
        pricing={quotedPricing}
        hasOrderForm={d.orderEnabled}
      />
    </div>
  </div>
</section>
