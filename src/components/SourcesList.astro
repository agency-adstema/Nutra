---
import Icon from './Icon.astro';
interface Props {
  sources: { title: string; url: string; publisher?: string }[];
  updatedAt?: Date;
}
const { sources } = Astro.props;
---

{
  sources.length > 0 && (
    <section aria-labelledby="izvori-title" id="izvori">
      <h2 id="izvori-title" class="text-xl font-semibold text-brand-strong sm:text-2xl">Izvori</h2>
      <ol class="mt-3 space-y-2 text-[15px]">
        {sources.map((s, i) => (
          <li class="flex gap-3">
            <span class="w-5 shrink-0 text-right text-muted">{i + 1}.</span>
            <span>
              <a href={s.url} target="_blank" rel="noopener" class="font-medium text-brand underline decoration-brand/30 underline-offset-2 hover:decoration-brand">
                {s.title}
                <Icon name="external" size={14} class="ml-0.5 inline -translate-y-px" />
              </a>
              {s.publisher && <span class="text-muted"> — {s.publisher}</span>}
            </span>
          </li>
        ))}
      </ol>
    </section>
  )
}
