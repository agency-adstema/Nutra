---
import Icon from './Icon.astro';
import ReviewStars from './ReviewStars.astro';
import OfferPrice from './OfferPrice.astro';
import { offerUrl, verticalLabel, type Offer } from '../data/offers';
import { getOfferDetails, getOfferImage } from '../data/offer-details';
import { getCatalogPrice } from '../data/offer-pricing';

interface Props { offer: Offer; }
const { offer } = Astro.props;
const details = getOfferDetails(offer.geo, offer.slug);
const photo = getOfferImage(details);
const quotedPricing = getCatalogPrice(offer.geo, offer.slug);
const href = offerUrl(offer);
const primaryCategory = verticalLabel(offer.verticals[0] ?? 'Proizvod');
const description = details?.description?.trim() || 'Više informacija o proizvodu na stranici ponude.';
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-[22px] border border-[#e5e2d9] bg-white shadow-sm transition-shadow hover:shadow-[var(--shadow-soft)]"
  data-offer-card
  data-geo={offer.geo}
  data-offer-slug={offer.slug}
>
  <a href={href} class="relative grid h-60 shrink-0 place-items-center overflow-hidden bg-[#e8efe1] p-4 text-[#1f4d2b]" aria-label={`Pogledaj ${offer.name}`}>
    {photo ? (
      <img src={photo} alt={`Fotografija pakovanja ${offer.name} prema katalogu partnera`}
        loading="lazy" decoding="async" width="400" height="260"
        class="h-full max-h-[226px] w-full object-contain transition-transform duration-500 group-hover:scale-[1.03]" />
    ) : (
      <Icon name="box" size={52} />
    )}
    <span class="absolute left-3 top-3 max-w-[80%] rounded-full bg-[#173d22] px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-white">
      {primaryCategory}
    </span>
    <span class="absolute right-3 top-3 rounded-full bg-white/95 px-2.5 py-1 text-[10px] font-semibold text-brand">{offer.geo}</span>
  </a>
  <div class="flex min-h-[286px] grow flex-col px-5 pb-5 pt-4" data-offer-card-body>
    <ReviewStars geo={offer.geo} slug={offer.slug} />

    <h3 class="mt-1.5 line-clamp-2 min-h-[2rem] font-serif text-xl font-bold leading-7 text-[#173d22]">
      <a href={href} class="hover:text-brand">{offer.name}</a>
    </h3>

    <p class="mt-1 line-clamp-2 min-h-[3rem] text-sm leading-6 text-ink/80">{description}</p>

    <div class="mt-auto pt-4">
      {quotedPricing ? (
        <>
          <OfferPrice pricing={quotedPricing} catalogCard />
          <a href={href} class="mt-3 flex w-full items-center justify-center gap-2 rounded-xl bg-[#1f5a2c] px-4 py-3.5 text-base font-bold text-white shadow-md shadow-[#1f5a2c]/25 transition hover:bg-[#173d22] active:scale-[0.99]">
            <Icon name="cart" size={20} /> Naruči odmah
          </a>
        </>
      ) : (
        <a href={href} class="inline-flex items-center gap-1 text-sm font-semibold text-brand">
          Detalji proizvoda <Icon name="arrow-right" size={17} />
        </a>
      )}
    </div>

    <p class="mt-2.5 text-center text-xs font-bold text-[#225b37]">Besplatna dostava · Plaćanje pouzećem</p>
  </div>
</article>
