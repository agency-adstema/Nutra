---
/**
 * Hero „video priče“ na početnoj — redosled i tekstovi u src/data/home-hero.json.
 *
 * Svaki slajd = jedan stvarni video iz src/data/product-videos.json (R2), sa
 * imenom osobe iz tog videa. Tekst je prepričan opis iz snimka, ne izmišljena izjava.
 *
 * SLIKA (levo): dizajnirani poster u public/images/hero/<slug>.jpg (ili .jpeg/.png/.webp),
 * preporuka 1600×1500 px, sve bitno u sredini kadra. Na posteru mora biti osoba
 * iz tog videa. Dok postera nema, prikazuje se kadar iz videa + pakovanje proizvoda.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getImage } from 'astro:assets';
import heroCfg from '../data/home-hero.json';
import { getProducts, productUrl } from '../lib/content';
import { getOffer, offerUrl, type OfferGeo } from '../data/offers';
import { getOfferDetails, getOfferImage } from '../data/offer-details';
import { videoR2Url } from '../config/video';
import Icon from './Icon.astro';

interface HeroEntry {
  slug: string;
  product: string;
  link: { type: 'product'; slug: string } | { type: 'offer'; geo: OfferGeo; slug: string };
  video: string;
  name: string;
  topic: string;
  headline: string;
  story: string;
}
interface Slide extends HeroEntry {
  href: string;
  videoSrc: string;
  poster: string | null;
  pack: string | null;
}

const products = await getProducts();
const customPoster = (slug: string) =>
  ['jpg', 'jpeg', 'png', 'webp'].map((ext) => `/images/hero/${slug}.${ext}`).find((p) => existsSync(join(process.cwd(), 'public', p)));

const slides: Slide[] = [];
for (const h of heroCfg as HeroEntry[]) {
  let href: string;
  let pack: string | null = null;
  if (h.link.type === 'product') {
    const slug = h.link.slug;
    const p = products.find((x) => x.data.slug === slug);
    if (!p) continue;
    href = productUrl(p);
    pack = (await getImage({ src: p.data.heroImage, width: 520, format: 'webp' })).src;
  } else {
    const o = getOffer(h.link.geo, h.link.slug);
    if (!o) continue;
    href = offerUrl(o);
    pack = getOfferImage(getOfferDetails(o.geo, o.slug));
  }
  slides.push({ ...h, href, pack, poster: customPoster(h.slug) ?? null, videoSrc: videoR2Url(h.video) });
}
---

{
  slides.length > 0 && (
    <div class="relative w-full min-w-0" data-hero-carousel role="region" aria-roledescription="carousel" aria-label="Video priče">
      <div
        class="flex snap-x snap-mandatory overflow-x-auto rounded-[1.75rem] shadow-[var(--shadow-soft)] ring-1 ring-black/5 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
        data-track
      >
        {slides.map((s, i) => (
          <article
            class="grid w-full shrink-0 snap-center bg-[#0d2517] text-white md:grid-cols-[1.05fr_1fr]"
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} od ${slides.length}: ${s.product}`}
            data-slide
          >
            <!-- Levo: poster / video -->
            <div class="relative aspect-[4/3] overflow-hidden bg-gradient-to-br from-[#6d9c34] via-[#4c7d27] to-[#24501a] md:aspect-auto md:min-h-[34rem]" data-media>
              {s.poster ? (
                <img
                  src={s.poster}
                  alt={`${s.name} sa proizvodom ${s.product}`}
                  width="1600"
                  height="1500"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                  decoding="async"
                  class="absolute inset-0 h-full w-full object-cover"
                />
              ) : (
                <>
                  <svg class="pointer-events-none absolute -right-10 -top-10 h-64 w-64 text-white/10" viewBox="0 0 100 100" aria-hidden="true">
                    <path fill="currentColor" d="M85 10C45 10 15 35 15 75c0 5 1 10 2 15 6-25 22-45 48-55-22 14-36 32-42 56 50 0 72-35 62-81Z" />
                  </svg>
                  <span class="absolute right-5 top-5 font-serif text-lg font-bold text-white/90">moja zdravica.</span>
                  <span class="absolute bottom-[8%] left-[8%] top-[10%] aspect-[9/16] overflow-hidden rounded-2xl bg-[#173d22] shadow-2xl ring-4 ring-white/25 md:-rotate-2">
                    <video
                      data-preview
                      data-src={`${s.videoSrc}#t=1`}
                      preload="none"
                      muted
                      playsinline
                      aria-hidden="true"
                      tabindex="-1"
                      class="pointer-events-none h-full w-full object-cover"
                    />
                  </span>
                  {s.pack && (
                    <img
                      src={s.pack}
                      alt={`Pakovanje proizvoda ${s.product}`}
                      width="520"
                      height="520"
                      loading={i === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                      class="absolute bottom-[7%] right-[6%] h-[56%] w-[40%] object-contain object-bottom drop-shadow-[0_18px_24px_rgba(0,0,0,0.35)]"
                    />
                  )}
                </>
              )}
              <span class="absolute left-4 top-4 inline-flex items-center gap-1.5 rounded-full bg-[#0d2517]/85 px-3 py-1 text-[11px] font-bold uppercase tracking-wide text-white backdrop-blur-sm">
                <Icon name="play" size={12} /> Video priča
              </span>
              <button
                type="button"
                class="group/play absolute left-1/2 top-1/2 grid h-20 w-20 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-white text-[#0d2517] shadow-2xl ring-8 ring-white/30 transition-transform hover:scale-105 sm:h-24 sm:w-24"
                aria-label={`Pusti video: ${s.name} o proizvodu ${s.product}`}
                data-play
                data-src={s.videoSrc}
                data-item-id={s.slug}
              >
                <span class="grid h-12 w-12 place-items-center rounded-full border-[3px] border-[#0d2517] sm:h-14 sm:w-14">
                  <Icon name="play" size={22} class="translate-x-[2px]" />
                </span>
              </button>
            </div>

            <!-- Desno: priča -->
            <div class="flex flex-col justify-center gap-5 p-6 sm:p-9 lg:p-12">
              <p class="text-[11px] font-extrabold uppercase tracking-[0.22em] text-[#c7e0a8]">Video priča · {s.topic}</p>
              <p class="font-serif text-[1.65rem] font-bold leading-[1.12] tracking-[-0.01em] sm:text-4xl lg:text-[2.6rem]">{s.headline}</p>
              <p class="text-[15px] leading-relaxed text-white/85 sm:text-base">{s.story}</p>
              <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm font-semibold text-white/90">
                <span class="inline-flex items-center gap-1.5 text-[#c7e0a8]"><Icon name="play" size={14} /> Video izjava</span>
                <span>{s.name} · {s.product}</span>
              </p>
              <p class="border-l-2 border-[#c7e0a8]/60 pl-4 text-sm italic leading-relaxed text-white/70">
                Lično iskustvo iz snimka (snimak: Limited Charm). Rezultati se razlikuju od osobe do osobe — nije zamena za savet lekara.
              </p>
              <div class="flex flex-wrap items-center gap-x-6 gap-y-3 pt-1">
                <a
                  href={s.href}
                  class="inline-flex items-center gap-1.5 rounded-xl bg-[#c7e0a8] px-4 py-2.5 text-sm font-bold text-[#0d2517] transition hover:bg-white"
                  data-select-item
                  data-list="home_hero"
                  data-item-id={s.slug}
                  data-item-name={s.product}
                >
                  Pogledajte {s.product} <Icon name="arrow-right" size={16} />
                </a>
                <button type="button" class="inline-flex items-center gap-1 text-xs font-extrabold uppercase tracking-[0.18em] text-[#c7e0a8] hover:text-white" data-play-link>
                  Pogledajte snimak <Icon name="chevron-right" size={16} />
                </button>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-4 flex items-center justify-center gap-4">
        <button type="button" class="grid h-10 w-10 place-items-center rounded-full border border-[#173d22]/15 bg-white text-ink shadow-sm hover:bg-[#e7efdc]" aria-label="Prethodna priča" data-prev>
          <Icon name="chevron-right" size={20} class="rotate-180" />
        </button>
        <div class="flex items-center gap-2">
        {slides.map((s, i) => (
          <button
            type="button"
            class="h-2.5 w-2.5 rounded-full bg-[#173d22]/20 transition-all aria-[current=true]:w-6 aria-[current=true]:bg-[#173d22]"
            aria-label={`Prikaži priču: ${s.name}, ${s.product}`}
            aria-current={i === 0 ? 'true' : undefined}
            data-dot={i}
          />
        ))}
        </div>
        <button type="button" class="grid h-10 w-10 place-items-center rounded-full border border-[#173d22]/15 bg-white text-ink shadow-sm hover:bg-[#e7efdc]" aria-label="Sledeća priča" data-next>
          <Icon name="chevron-right" size={20} />
        </button>
      </div>
    </div>
  )
}

<script>
  import { track } from '../scripts/analytics';

  function initHeroCarousel(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    if (!track || slides.length === 0) return;
    const count = slides.length;
    let index = 0;
    let paused = false;
    let playing = false;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Kadar iz videa učitavamo samo za trenutni i sledeći slajd.
    const hydrate = (i: number) => {
      [i, (i + 1) % count].forEach((n) => {
        const v = slides[n]?.querySelector<HTMLVideoElement>('video[data-preview]');
        if (v && !v.src && v.dataset.src) {
          v.preload = 'metadata';
          v.src = v.dataset.src;
        }
      });
    };

    const stopPlayers = () => {
      root.querySelectorAll<HTMLVideoElement>('video[data-player]').forEach((v) => {
        v.pause();
        v.remove();
      });
      root.querySelectorAll<HTMLElement>('[data-play]').forEach((b) => (b.hidden = false));
      playing = false;
    };

    const go = (i: number) => {
      index = (i + count) % count;
      stopPlayers();
      hydrate(index);
      track.scrollTo({ left: index * track.clientWidth, behavior: reduce ? 'auto' : 'smooth' });
    };

    const play = (slide: HTMLElement) => {
      const btn = slide.querySelector<HTMLButtonElement>('[data-play]');
      const media = slide.querySelector<HTMLElement>('[data-media]');
      if (!btn || !media || !btn.dataset.src) return;
      stopPlayers();
      const v = document.createElement('video');
      v.src = btn.dataset.src;
      v.controls = true;
      v.autoplay = true;
      v.playsInline = true;
      v.dataset.player = '';
      v.className = 'absolute inset-0 z-10 h-full w-full bg-black object-contain';
      v.addEventListener('ended', () => stopPlayers());
      media.appendChild(v);
      btn.hidden = true;
      playing = true;
      v.play().catch(() => {});
      track('video_start', { item_id: btn.dataset.itemId, item_list_name: 'home_hero' });
    };

    let timer: number | undefined;
    track.addEventListener(
      'scroll',
      () => {
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          const next = Math.round(track.scrollLeft / Math.max(1, track.clientWidth));
          if (next !== index) stopPlayers();
          index = next;
          hydrate(index);
          dots.forEach((d, i) => (i === index ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
        }, 80);
      },
      { passive: true },
    );
    slides.forEach((slide) => {
      slide.querySelector('[data-play]')?.addEventListener('click', () => play(slide));
      slide.querySelector('[data-play-link]')?.addEventListener('click', () => play(slide));
    });
    root.querySelector('[data-prev]')?.addEventListener('click', () => go(index - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => go(index + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));

    root.addEventListener('mouseenter', () => (paused = true));
    root.addEventListener('mouseleave', () => (paused = false));
    root.addEventListener('focusin', () => (paused = true));
    root.addEventListener('focusout', () => (paused = false));
    root.addEventListener('touchstart', () => (paused = true), { passive: true });

    hydrate(0);
    if (!reduce && count > 1) {
      window.setInterval(() => {
        if (!paused && !playing && document.visibilityState === 'visible') go(index + 1);
      }, 8000);
    }
  }
  document.querySelectorAll<HTMLElement>('[data-hero-carousel]').forEach(initHeroCarousel);
</script>
