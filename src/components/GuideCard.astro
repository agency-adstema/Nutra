---
import Icon from './Icon.astro';
import { guideUrl, type Guide } from '../lib/content';
import { formatDate } from '../lib/format';
interface Props {
  guide: Guide;
  categoryName?: string;
}
const { guide, categoryName } = Astro.props;
const d = guide.data;
---

<article class="card group relative flex h-full flex-col overflow-hidden p-6">
  <div class="absolute -right-6 -top-6 h-24 w-24 rounded-full bg-[#e7efdc] transition-transform duration-500 group-hover:scale-125" aria-hidden="true"></div>
  <div class="relative flex items-center gap-2 text-xs font-semibold tracking-wider text-[#5d8c3c] uppercase">
    <Icon name="book" size={16} />
    <span>{categoryName ?? 'Vodič'}</span>
    {d.demo && <span class="demo-badge ml-auto">Demo</span>}
  </div>
  <h3 class="relative mt-3 text-xl leading-snug font-semibold text-ink">
    <a href={guideUrl(guide)} class="after:absolute after:inset-0 hover:text-[#1f4d2b]">{d.title}</a>
  </h3>
  <p class="relative mt-2 line-clamp-3 text-[15px] leading-relaxed text-muted">{d.description}</p>
  <p class="relative mt-auto flex items-center gap-3 pt-5 text-sm text-muted">
    <span>Ažurirano {formatDate(d.updatedAt)}</span>
    {d.readingMinutes && <span>· {d.readingMinutes} min čitanja</span>}
  </p>
</article>
