---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site } from '../config/site';
import { getCategories, categoryUrl } from '../lib/content';

const categories = await getCategories();
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-line/70 bg-[#f3efe4]">
  <div class="container-site grid gap-10 py-12 md:grid-cols-[1.3fr_1fr_1fr]">
    <div>
      <Logo size="sm" />
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-muted">
        {site.name} je vodič kroz prirodne preparate. Nismo apoteka niti medicinska ustanova.
        Prodavac potvrđuje porudžbinu telefonskim pozivom.
      </p>
      <p class="mt-4 flex items-start gap-2 text-sm italic text-ink/80">
        <Icon name="info" size={18} class="mt-0.5 shrink-0" />
        {site.medicalDisclaimer} Dodaci ishrani nisu lekovi.
      </p>
    </div>

    <nav aria-label="Kategorije">
      <p class="mb-3 text-sm font-semibold tracking-wider text-ink uppercase">Kategorije</p>
      <ul class="space-y-2 text-sm">
        {categories.map((c) => <li><a class="text-muted hover:text-ink" href={categoryUrl(c)}>{c.data.name}</a></li>)}
        <li><a class="text-muted hover:text-ink" href="/ponude/">Sve ponude</a></li>
        <li><a class="text-muted hover:text-ink" href="/vodici/">Vodiči</a></li>
      </ul>
    </nav>

    <nav aria-label="Informacije">
      <p class="mb-3 text-sm font-semibold tracking-wider text-ink uppercase">Informacije</p>
      <ul class="space-y-2 text-sm">
        {site.footerLinks.map((l) => <li><a class="text-muted hover:text-ink" href={l.href}>{l.label}</a></li>)}
        <li><button type="button" class="text-muted underline-offset-2 hover:text-ink hover:underline" data-open-consent>Podešavanja kolačića</button></li>
      </ul>
    </nav>


  </div>
  <div class="border-t border-line/70">
    <div class="container-site grid gap-2 py-5 text-xs text-muted sm:grid-cols-3 sm:items-center">
      <p>© {year} {site.name}. Sva prava zadržana.</p>
      <a
        href="https://adstema.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="w-fit font-medium text-muted transition-colors hover:text-brand-strong hover:underline sm:justify-self-center"
        aria-label="Powered by Adstema — poseti adstema.com"
      >
        Powered by <span class="font-semibold text-brand-strong">Adstema</span>
      </a>
      <div aria-hidden="true"></div>
    </div>
  </div>
</footer>
