---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import OfferCard from '../../components/OfferCard.astro';
import { getCatalogOffersForCategory } from '../../data/offer-categories';
import GuideCard from '../../components/GuideCard.astro';
import FaqList from '../../components/FaqList.astro';
import Icon from '../../components/Icon.astro';
import LeafDecor from '../../components/LeafDecor.astro';
import { getCategories, getProducts, getGuides, type Category } from '../../lib/content';
import { reservedSlugs } from '../../config/site';
import { faqSchema } from '../../lib/seo';
import { PUBLIC_ORDER_ENDPOINT, PUBLIC_CATALOG_ORDER_SUBMISSIONS } from 'astro:env/client';

export async function getStaticPaths() {
  const categories = await getCategories();
  for (const c of categories) {
    if (reservedSlugs.includes(c.data.slug)) throw new Error(`Slug kategorije "${c.data.slug}" je rezervisan.`);
  }
  return categories.map((c) => ({ params: { category: c.data.slug }, props: { category: c } }));
}

interface Props {
  category: Category;
}
const { category } = Astro.props;
const d = category.data;
const { Content } = await render(category);
const products = (await getProducts()).filter((p) => p.data.category.id === category.id);
const guides = (await getGuides()).filter((g) => g.data.category?.id === category.id);
const path = `/${d.slug}/`;
const others = (await getCategories()).filter((c) => c.id !== category.id);
const catalogOffers = getCatalogOffersForCategory(d.slug).filter((o) => !products.some((p) => p.data.name.toLowerCase() === o.name.toLowerCase()));
const orderingOn = !!(PUBLIC_ORDER_ENDPOINT && PUBLIC_CATALOG_ORDER_SUBMISSIONS);
// Kada nemamo svoje stranice proizvoda, ponude iz kataloga su glavni spisak proizvoda.
const onlyCatalog = products.length === 0 && catalogOffers.length > 0;
---

<BaseLayout
  title={d.seo.title}
  description={d.seo.description}
  path={path}
  breadcrumbs={[{ name: d.name, href: path }]}
  jsonLd={[{ '@type': 'CollectionPage', name: d.name, description: d.seo.description }, ...(d.faqSchema && d.faq.length ? [faqSchema(d.faq)] : [])]}
  noindex={products.length === 0 && catalogOffers.length === 0}
>
  <section class="relative overflow-hidden">
    <LeafDecor class="-right-10 top-0 w-56 rotate-12" />
    <div class="container-site relative py-8 lg:py-12">
      <Breadcrumbs items={[{ name: d.name, href: path }]} />
      <div class="mt-6 flex items-start gap-4">
        <span class="hidden h-16 w-16 shrink-0 place-items-center rounded-2xl bg-[#e7efdc] text-[#1f4d2b] sm:grid">
          <Icon name={d.icon} size={32} />
        </span>
        <div>
          <h1 class="text-4xl font-bold text-[#173d22] sm:text-5xl">{d.name}</h1>
          <div class="prose-bk mt-3 max-w-3xl">
            {d.intro ? <p>{d.intro}</p> : <Content />}
          </div>
        </div>
      </div>
    </div>
  </section>

  {!onlyCatalog && (
  <section class="container-site py-6" aria-labelledby="proizvodi-title">
    <h2 id="proizvodi-title" class="text-2xl font-semibold text-[#173d22] sm:text-3xl">Proizvodi u kategoriji</h2>
    {
      products.length ? (
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {products.map((p, i) => <ProductCard product={p} list={`category_${d.slug}`} eager={i < 3} />)}
        </div>
      ) : catalogOffers.length > 0 ? null : (
        <div class="mt-5 rounded-2xl border border-dashed border-line bg-paper p-6">
          <p class="font-semibold text-ink">Proizvode u ovoj kategoriji dodajemo uskoro.</p>
          <p class="mt-1 text-muted">Objavljujemo ih tek kada proverimo sastav, cenu i upozorenja. Do tada pogledajte druge kategorije:</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {others.map((c) => (
              <a href={`/${c.data.slug}/`} class="pill bg-[#e7efdc] text-[#1f4d2b] hover:bg-[#dbe8cc]">
                <Icon name={c.data.icon} size={16} /> {c.data.name}
              </a>
            ))}
          </div>
        </div>
      )
    }
  </section>
  )}

  {
    catalogOffers.length > 0 && (
      <section class="container-site py-8" aria-labelledby="kat-katalog">
        <h2 id="kat-katalog" class="text-2xl font-semibold text-[#173d22] sm:text-3xl">{onlyCatalog ? 'Proizvodi u kategoriji' : 'Dodatne ponude u kategoriji'}</h2>
        <p class="mt-2 max-w-2xl text-muted">
          Ponude za Srbiju sa fotografijama i cenama iz partnerskog cenovnika. Konačnu dostupnost i cenu potvrđuje prodavac{orderingOn ? '; poručujete preko forme na stranici proizvoda, uz plaćanje pouzećem.' : '; poručivanje još nije aktivirano.'}
        </p>
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {catalogOffers.map((offer) => <OfferCard offer={offer} />)}
        </div>
      </section>
    )
  }

  {
    guides.length > 0 && (
      <section class="container-site py-10" aria-labelledby="kat-vodici-title">
        <h2 id="kat-vodici-title" class="text-2xl font-semibold text-[#173d22] sm:text-3xl">Vodiči za ovu temu</h2>
        <div class="mt-6 grid gap-6 md:grid-cols-3">
          {guides.map((g) => <GuideCard guide={g} categoryName={d.name} />)}
        </div>
      </section>
    )
  }

  {
    d.intro && (
      <section class="container-site py-4" aria-label={`Više o temi: ${d.name}`}>
        <div class="prose-bk max-w-3xl">
          <Content />
        </div>
      </section>
    )
  }

  <div class="container-site py-6">
    <FaqList items={d.faq} title="Često postavljana pitanja" />
  </div>
</BaseLayout>
