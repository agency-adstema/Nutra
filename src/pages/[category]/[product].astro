---
import { getEntry, render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ProductHero from '../../components/product/ProductHero.astro';
import ProductOverview from '../../components/product/ProductOverview.astro';
import ProductComposition from '../../components/product/ProductComposition.astro';
import QuotedReviews from '../../components/product/QuotedReviews.astro';
import VideoReviews from '../../components/product/VideoReviews.astro';
import OrderForm from '../../components/product/OrderForm.astro';
import StickyCta from '../../components/product/StickyCta.astro';
import FaqList from '../../components/FaqList.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getProducts, getProductsByIds, productUrl, visibleVideos, type Product } from '../../lib/content';
import { priceView, themeStyle } from '../../lib/format';
import { productSchema, faqSchema } from '../../lib/seo';
import { getMarket } from '../../config/countries';
import { site } from '../../config/site';
import { getExternalReview } from '../../data/external-reviews';
import { getLcDetails, lcCheckedAt, lcSourceName } from '../../data/limitedcharm-details';

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((p) => ({ params: { category: p.data.category.id, product: p.data.slug }, props: { product: p } }));
}

interface Props {
  product: Product;
}
const { product } = Astro.props;
const d = product.data;
const category = await getEntry(d.category);
if (!category) throw new Error(`Kategorija "${d.category.id}" ne postoji (proizvod ${d.slug})`);
const market = getMarket(d.countryCode);
const { Content } = await render(product);
const related = await getProductsByIds(d.related);
const videos = visibleVideos(product);
const pv = priceView(d.priceStatus, d.packages);
const path = productUrl(product);
const siteUrl = (Astro.site?.toString() ?? '').replace(/\/$/, '');
const lc = getLcDetails(d.countryCode, d.slug);
const ext = d.countryCode === 'RS' || d.countryCode === 'BA' || d.countryCode === 'HR' ? getExternalReview(d.countryCode, d.slug) : undefined;
const composition = d.composition
  ? { ...d.composition, label: d.composition.activeLabel, name: d.composition.activeName, latin: d.composition.activeLatin }
  : lc?.composition
    ? { ...lc.composition, sourceName: lcSourceName, checkedAt: lcCheckedAt }
    : null;
const quoted = d.quotedReviews
  ? {
      productName: d.name,
      sourceName: d.quotedReviews.sourceName,
      checkedAt: d.quotedReviews.checkedAt,
      score: lc?.reviews?.score ?? ext?.score,
      count: lc?.reviews?.count ?? ext?.count,
      items: d.quotedReviews.items,
    }
  : lc?.reviews
    ? { productName: d.name, sourceName: lcSourceName, checkedAt: lcCheckedAt, ...lc.reviews }
    : null;
const heroImg = await getImage({ src: d.heroImage, width: 1104, format: 'jpg' });

const jsonLd: Record<string, unknown>[] = [
  productSchema({
    url: `${siteUrl}${path}`,
    name: d.name,
    description: d.shortDescription,
    image: new URL(heroImg.src, `${siteUrl}/`).toString(),
    category: category.data.name,
    priceStatus: d.priceStatus,
    priceCheckedAt: d.priceCheckedAt,
    currency: d.currency,
    prices: d.packages.map((p) => p.price).filter((p): p is number => typeof p === 'number'),
  }),
];
if (d.faqSchema && d.faq.length) jsonLd.push(faqSchema(d.faq));

const tabs = [
  { href: '#opis', label: 'Opis proizvoda' },
  { href: '#sastav', label: 'Sastav i upotreba' },
  { href: '#cena', label: 'Cena i pakovanja' },
  ...(quoted ? [{ href: '#recenzije', label: 'Recenzije' }] : []),
  ...(videos.length ? [{ href: '#video', label: 'Video iskustva' }] : []),
  ...(d.orderEnabled ? [{ href: '#poruci', label: 'Poručite' }] : []),
];

const productInfo = {
  slug: d.slug,
  name: d.name,
  category: d.category.id,
  currency: d.currency,
  value: pv.isVerified ? pv.min : undefined,
};
---

<BaseLayout
  title={d.seo.title}
  description={d.seo.description}
  path={path}
  ogImage={d.heroImage}
  ogImageAlt={d.heroImageAlt}
  ogType="product"
  breadcrumbs={[
    { name: category.data.name, href: `/${category.data.slug}/` },
    { name: d.h1 ?? d.name, href: path },
  ]}
  jsonLd={jsonLd}
  themeStyle={themeStyle(d)}
  bodyClass="pb-20 lg:pb-0"
>
  <div data-product-page data-product={JSON.stringify(productInfo)}>

    <ProductHero product={product} categoryName={category.data.name} categoryHref={`/${category.data.slug}/`} market={market} />

    <!-- Tabovi (desktop) -->
    <nav class="sticky top-[var(--header-h)] z-30 hidden py-2 lg:block" aria-label="Sadržaj stranice">
      <div class="container-site">
        <ul class="mx-auto flex max-w-4xl items-center justify-between gap-1 rounded-2xl border border-line bg-paper/95 p-1.5 shadow-sm backdrop-blur">
          {
            tabs.map((t, i) => (
              <li class="flex-1">
                <a
                  href={t.href}
                  data-tab
                  aria-current={i === 0 ? 'true' : undefined}
                  class="block rounded-xl px-4 py-2 text-center text-[15px] font-medium text-ink/85 transition-colors hover:bg-brand-soft aria-[current=true]:bg-brand aria-[current=true]:text-white"
                >
                  {t.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>

    <div class="space-y-14 pt-6 lg:space-y-20 lg:pt-10">
      <ProductOverview product={product} market={market} />

      <ProductComposition data={composition} />

      <!-- Detaljno + kome nije namenjen / upozorenja -->
      <section class="container-site grid gap-8 lg:grid-cols-[1.55fr_1fr] lg:gap-12" aria-labelledby="detalji-title">
        <div>
          <h2 id="detalji-title" class="text-2xl font-semibold text-brand-strong sm:text-[2rem]">Detaljnije o proizvodu {d.name}</h2>
          <div class="prose-bk mt-2">
            <Content />
          </div>
        </div>
        <aside class="space-y-4">
          {
            d.notFor.length > 0 && (
              <div class="card p-5">
                <h2 class="flex items-center gap-2 text-xl font-semibold text-ink">
                  <Icon name="shield" size={22} class="text-accent" /> Kome nije namenjen
                </h2>
                <ul class="mt-3 space-y-2 text-[15px] text-ink/85">
                  {d.notFor.map((x) => (
                    <li class="flex gap-2"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />{x}</li>
                  ))}
                </ul>
              </div>
            )
          }
          {
            d.warnings.length > 0 && (
              <div class="rounded-[var(--radius-card)] border border-warn/25 bg-warn-bg/70 p-5">
                <h2 class="flex items-center gap-2 text-xl font-semibold text-ink">
                  <Icon name="alert" size={22} class="text-warn" /> Upozorenja i kontraindikacije
                </h2>
                <ul class="mt-3 space-y-2 text-[15px] text-ink/90">
                  {d.warnings.map((x) => (
                    <li class="flex gap-2"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-warn" />{x}</li>
                  ))}
                </ul>
              </div>
            )
          }
          <p class="flex items-start gap-2 rounded-xl bg-paper px-4 py-3 text-sm text-muted ring-1 ring-line">
            <Icon name="info" size={18} class="mt-0.5 shrink-0" />
            <span>{site.medicalDisclaimer} Dodaci ishrani i kozmetički proizvodi nisu lekovi.</span>
          </p>
        </aside>
      </section>

      {
        d.comparison && (
          <section class="container-site" aria-labelledby="poredjenje-title">
            <h2 id="poredjenje-title" class="text-2xl font-semibold text-brand-strong sm:text-[2rem]">Poređenje sa alternativama</h2>
            {d.comparison.intro && <p class="mt-2 max-w-3xl text-ink/80">{d.comparison.intro}</p>}
            <div class="mt-5 overflow-x-auto rounded-2xl border border-line bg-paper">
              <table class="w-full min-w-[640px] text-[15px]">
                <thead class="bg-brand-2/70 text-left">
                  <tr>
                    <th scope="col" class="w-44 px-4 py-3" />
                    {d.comparison.columns.map((c, i) => (
                      <th scope="col" class={`px-4 py-3 font-semibold ${i === 0 ? 'text-brand-strong' : 'text-ink'}`}>{c}</th>
                    ))}
                  </tr>
                </thead>
                <tbody class="divide-y divide-line">
                  {d.comparison.rows.map((r) => (
                    <tr>
                      <th scope="row" class="px-4 py-3 text-left font-semibold text-ink">{r.label}</th>
                      {r.values.map((v) => <td class="px-4 py-3 align-top text-ink/85">{v}</td>)}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            {d.comparison.note && <p class="mt-3 text-sm text-muted">{d.comparison.note}</p>}
          </section>
        )
      }

      <QuotedReviews data={quoted} />

      <div class="container-site">
        <FaqList items={d.faq} title={`Često postavljana pitanja o proizvodu ${d.name}`} />
      </div>

      <!-- Video iskustva + forma -->
      <div class="container-site">
        {
          videos.length > 0 ? (
            <div class="grid items-start gap-10 lg:grid-cols-[1.35fr_1fr] lg:gap-10">
              <VideoReviews product={product} />
              <OrderForm product={product} market={market} />
            </div>
          ) : (
            <div class="grid items-start gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-14">
              <div class="lg:pt-6">
                <h2 class="text-2xl font-semibold text-brand-strong sm:text-[2rem]">Kako izgleda poručivanje</h2>
                <ol class="mt-6 space-y-5">
                  {[
                    ['Popunite formu', 'Samo ime, prezime i broj telefona — bez registracije i plaćanja karticom.'],
                    ['Operater vas poziva', 'Potvrđuje porudžbinu, cenu, pakovanje i adresu dostave.'],
                    ['Plaćate pri preuzimanju', 'Plaćanje pouzećem kuriru, prema uslovima prodavca.'],
                  ].map(([t, s], i) => (
                    <li class="flex gap-4">
                      <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-brand font-bold text-white">{i + 1}</span>
                      <span>
                        <span class="block font-semibold text-ink">{t}</span>
                        <span class="block text-ink/75">{s}</span>
                      </span>
                    </li>
                  ))}
                </ol>
              </div>
              <OrderForm product={product} market={market} />
            </div>
          )
        }
      </div>

      {
        related.length > 0 && (
          <section class="container-site" aria-labelledby="srodni-title">
            <h2 id="srodni-title" class="text-2xl font-semibold text-brand-strong sm:text-[2rem]">Srodni proizvodi</h2>
            <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {related.map((r) => <ProductCard product={r} list="related" />)}
            </div>
          </section>
        )
      }
    </div>

    <StickyCta product={product} market={market} />
  </div>
</BaseLayout>

<script>
  import { initProductPage } from '../../scripts/product-page';
  initProductPage();
</script>
