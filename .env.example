# ------------------------------------------------------------------
# Biljni kompas — primer podešavanja (kopirati u .env, NE commit-ovati .env)
# ------------------------------------------------------------------

# Adresa sajta (canonical, sitemap, OG)
SITE_URL=https://biljnikompas.rs

# staging = noindex + robots Disallow; production = indeksiranje uključeno
PUBLIC_SITE_ENV=staging
PUBLIC_MARKET=RS
# Forma je isključena i u non-static build-u dok se ovaj javni prekidač ne uključi.
# Samostalno uključivanje NE aktivira CRM bez zasebnog serverskog CATALOG_ORDERS_ENABLED.
PUBLIC_CATALOG_ORDER_SUBMISSIONS=false

# Analitika (opciono; učitava se tek posle saglasnosti za kolačiće)
PUBLIC_GA4_ID=
PUBLIC_GTM_ID=

# Cloudflare Turnstile (opciono, dodatna zaštita forme)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------- Porudžbine / MonadLead (samo server) --------------
# test = ništa se ne šalje u CRM, korisnik vidi „testni režim“
# live = šalje se u MonadLead
ORDER_MODE=test
MONADLEAD_API_KEY=
# Poseban ključ po tržištu (ima prednost nad MONADLEAD_API_KEY)
MONADLEAD_API_KEY_RS=

# NOVI (odvojeni) MonadLead nalog za katalog od 45 ponuda RS/BA/HR.
# Tajni ključ se čuva samo u server env/.env uz chmod 600; NIKAD u GitHub.
# Ne koristi stari MONADLEAD_API_KEY kao fallback za katalog.
MONADLEAD_API_KEY_CATALOG=

# Globalna dozvola za stvarno slanje kataloških porudžbina.
# Ne uključivati pre produkcionog backend deploya i validacije naloga.
CATALOG_ORDERS_ENABLED=false

# Pravi numerički offer_id za SVAKU ponudu, po tačnoj GEO+slug kombinaciji.
# Vrednost "1769" iz API dokumentacije je samo primer, ne dodeljivati je svima.
# CATALOG_OFFER_ID_HR_CY_RELIEF=
# CATALOG_OFFER_ID_RS_PARAZOL=
# CATALOG_OFFER_ID_BA_NAUTUBONE=
# CATALOG_OFFER_ID_RS_HP_BONE_CONTROL=
# Samo za testiranje sa lokalnim mock serverom; u produkciji ostaviti prazno
MONADLEAD_API_URL=

# Offer ID može i preko env-a (ima prednost nad Markdown poljem offerId):
# OFFER_ID_NAUTUBONE=
# OFFER_ID_BONECONTROL=
# OFFER_ID_PARAZOL=

# Nasumičan string (npr. openssl rand -hex 32) — za heširanje IP/telefona u zaštiti od duplih
ORDER_HASH_SALT=

# Dozvoljeni dodatni Origin-i za /api/order (zarezom odvojeni), npr. preview domen
ALLOWED_ORIGINS=

# Upstash Redis (preporučeno na Vercel/Cloudflare: rate limit i duplikati važe za sve instance)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Generički webhook (za tržišta gde je crm.provider = 'webhook')
ORDER_WEBHOOK_URL=
ORDER_WEBHOOK_SECRET=

# Deploy cilj: vercel | cloudflare | node (automatski se prepoznaje na Vercel/CF Pages)
# DEPLOY_TARGET=
